# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/technical_test

# Authentication
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=8h

# Password Hashing
BCRYPT_ROUNDS=12

# Business Timezone
APP_TIMEZONE=Asia/Jakarta

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:3001
